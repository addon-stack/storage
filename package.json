{
  "name": "@addon-core/storage",
  "version": "0.8.0",
  "description": "Developer-friendly, type-safe storage for browser extensions with functional helpers, batch operations, encryption, and subscriptions.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/addon-stack/storage.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/addon-stack/storage",
  "bugs": {
    "url": "https://github.com/addon-stack/storage/issues"
  },
  "keywords": [
    "storage",
    "addon",
    "extension",
    "browser",
    "chrome",
    "firefox",
    "edge",
    "opera",
    "safari",
    "react"
  ],
  "author": "Anjey Tsibylskij (https://github.com/atldays)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/adapters/*/index.d.ts",
      "import": "./dist/adapters/*/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "fix": "eslint . --fix --max-warnings 0",
    "lint:staged": "lint-staged",
    "test": "jest --config jest.config.ts",
    "test:all": "npm test -- --bail --passWithNoTests && npm run test:tooling",
    "test:ci": "npm test -- --ci --passWithNoTests --coverage && npm run test:tooling -- --ci",
    "test:related": "npm test -- --bail --passWithNoTests --findRelatedTests",
    "test:tooling": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.tooling.config.js --runInBand",
    "test:consumer-types": "npm run build && node tests/consumer-types/check.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json && tsc -p tests/types/tsconfig.exact.json",
    "release": "release-it",
    "release:preview": "release-it --no-github.release --no-npm.publish --no-git.tag --ci"
  },
  "lint-staged": {
    "*": "eslint --fix --max-warnings 0 --no-warn-ignored --"
  },
  "overrides": {
    "glob": "^9.3.5",
    "source-map": "npm:source-map-js@^1.2.0",
    "undici": "6.24.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "9.39.5",
    "@microsoft/api-extractor": "^7.52.13",
    "@release-it/conventional-changelog": "^10.0.1",
    "@stylistic/eslint-plugin": "4.4.1",
    "@swc/core": "^1.7.0",
    "@swc/jest": "^0.2.36",
    "@testing-library/react": "^16.3.0",
    "@types/chrome": "^0.1.12",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild-fix-imports-plugin": "^1.0.22",
    "eslint": "9.39.5",
    "eslint-plugin-import-x": "4.16.1",
    "eslint-plugin-jsonc": "2.21.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "16.5.0",
    "husky": "^9.0.11",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "lint-staged": "15.5.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "release-it": "^19.0.5",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.48.1"
  },
  "dependencies": {
    "@addon-core/browser": "^0.9.0",
    "dequal": "^2.0.3"
  },
  "peerDependencies": {
    "@types/chrome": "*",
    "@types/react": "^18.0.0 || ^19.0.0",
    "@types/react-dom": "^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "typescript": ">=5.4"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
